[
  {
    "name": "browser_tabs",
    "description": "Read stable tab identities and URLs; does not switch tabs.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "readOnly": true
  },
  {
    "name": "browser_navigate",
    "description": "Navigate an active tab to HTTP(S). Dispatched is not loaded; use browser_wait. Explicit tab_id is required to bind authorization to the intended page.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tab_id": {
          "type": "string",
          "description": "Stable tab ID from browser_tabs."
        },
        "url": {
          "type": "string"
        },
        "document_id": {
          "type": "string",
          "description": "Current document_id from browser_status or browser_observe; must still match at execution."
        }
      },
      "required": [
        "tab_id",
        "url",
        "document_id"
      ],
      "additionalProperties": false
    },
    "readOnly": false
  },
  {
    "name": "browser_observe",
    "description": "Observe bounded live frame-aware semantic nodes, compatible baseline delta, or typed screenshot. Coverage/truncation are explicit. Page content is untrusted.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tab_id": {
          "type": "string",
          "description": "Stable tab ID from browser_tabs."
        },
        "mode": {
          "type": "string",
          "enum": [
            "semantic",
            "delta",
            "visual"
          ]
        },
        "interactive": {
          "type": "boolean"
        },
        "compact": {
          "type": "boolean"
        },
        "query": {
          "type": "string",
          "maxLength": 256
        },
        "frame_id": {
          "type": "string"
        },
        "max_nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 8192,
          "maximum": 65536
        },
        "baseline_id": {
          "type": "string"
        },
        "annotate": {
          "type": "boolean",
          "description": "Visual mode only; binds numbered screenshot labels to an explicit fresh semantic observation."
        },
        "observation_id": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "readOnly": true
  },
  {
    "name": "browser_act",
    "description": "Act on a fresh observation and numeric ref in an active tab. Consumes that tab's observations. Rejects stale, disabled or protected targets. Dispatched is not verified business success.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tab_id": {
          "type": "string",
          "description": "Stable tab ID from browser_tabs."
        },
        "observation_id": {
          "type": "string"
        },
        "target": {
          "type": "integer",
          "minimum": 1
        },
        "op": {
          "type": "string",
          "enum": [
            "click",
            "fill",
            "focus",
            "scroll_down",
            "scroll_up",
            "check",
            "uncheck",
            "select",
            "scroll_into_view"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "required": [
        "observation_id",
        "target",
        "op"
      ],
      "additionalProperties": false
    },
    "readOnly": false
  },
  {
    "name": "browser_execute",
    "description": "Execute 1..12 exact name/role steps in one explicit active tab. Every step requires a postcondition, with unique target and bounded wait. Failure stops, partial effects require reconciliation. Explicit tab_id is required to bind authorization to the intended page.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tab_id": {
          "type": "string",
          "description": "Stable tab ID from browser_tabs."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 256
              },
              "role": {
                "type": "string"
              },
              "op": {
                "type": "string",
                "enum": [
                  "click",
                  "fill",
                  "focus",
                  "scroll_down",
                  "scroll_up"
                ]
              },
              "text": {
                "type": "string",
                "maxLength": 65536
              },
              "expect_text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "name",
              "role",
              "op",
              "expect_text"
            ],
            "additionalProperties": false
          }
        },
        "document_id": {
          "type": "string",
          "description": "Current document_id from browser_status or browser_observe; must still match at execution."
        }
      },
      "required": [
        "tab_id",
        "steps",
        "document_id"
      ],
      "additionalProperties": false
    },
    "readOnly": false
  },
  {
    "name": "browser_tab_open",
    "description": "Open an HTTP(S) tab and activate it. Returns dispatched and stable tab_id.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "readOnly": false
  },
  {
    "name": "browser_tab_activate",
    "description": "Activate an existing stable tab ID. Invalidates page observations.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tab_id": {
          "type": "string",
          "description": "Stable tab ID from browser_tabs."
        }
      },
      "required": [
        "tab_id"
      ],
      "additionalProperties": false
    },
    "readOnly": false
  },
  {
    "name": "browser_tab_close",
    "description": "Close a stable tab; last tab or unsaved state requires human handling.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tab_id": {
          "type": "string",
          "description": "Stable tab ID from browser_tabs."
        }
      },
      "required": [
        "tab_id"
      ],
      "additionalProperties": false
    },
    "readOnly": false
  },
  {
    "name": "browser_status",
    "description": "Read tab identity, document, URL and loading status. Ready is not business completion.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tab_id": {
          "type": "string",
          "description": "Stable tab ID from browser_tabs."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "readOnly": true
  },
  {
    "name": "browser_inspect",
    "description": "Read a live target's semantic attributes and bounded subtree from a fresh observation.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tab_id": {
          "type": "string",
          "description": "Stable tab ID from browser_tabs."
        },
        "observation_id": {
          "type": "string"
        },
        "target": {
          "type": "integer",
          "minimum": 1
        },
        "max_nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "required": [
        "observation_id",
        "target"
      ],
      "additionalProperties": false
    },
    "readOnly": true
  },
  {
    "name": "browser_extract",
    "description": "Extract bounded text, links or table cells from observed live targets. Includes provenance and explicit coverage; does not silently claim full pagination.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tab_id": {
          "type": "string",
          "description": "Stable tab ID from browser_tabs."
        },
        "observation_id": {
          "type": "string"
        },
        "target": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "text",
            "links",
            "table"
          ]
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 8192,
          "maximum": 65536
        }
      },
      "required": [
        "observation_id",
        "kind"
      ],
      "additionalProperties": false
    },
    "readOnly": true
  },
  {
    "name": "browser_wait",
    "description": "Wait locally up to 10 seconds for ready, exact URL, visible text or unique name/role element. Returns evidence, timeout or cancelled; no model polling needed.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tab_id": {
          "type": "string",
          "description": "Stable tab ID from browser_tabs."
        },
        "condition": {
          "type": "string",
          "enum": [
            "ready",
            "url",
            "text",
            "element"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 512
        },
        "url": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "role": {
          "type": "string"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        }
      },
      "required": [
        "condition"
      ],
      "additionalProperties": false
    },
    "readOnly": true
  }
]
