{
  "name": "orders_list",
  "description": "All orders (id, customer, total, status, date), optionally filtered by a search query and/or status; follows pagination.",
  "risk": "read",
  "reads": [
    "order"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Customer name or order id; empty for all"
      },
      "status": {
        "type": "string",
        "description": "paid | shipped | refunded | pending; empty for all"
      }
    }
  },
  "steps": [
    {
      "do": "goto",
      "url": "{base_url}/admin/orders/?q={query}&status={status}"
    },
    {
      "do": "assert",
      "selector": "[data-testid=account-menu]",
      "message": "not logged in; call auth_ensure_login"
    },
    {
      "do": "wait",
      "selector": "table.orders"
    },
    {
      "do": "collect_pages",
      "selector": "table.orders",
      "as": "orders",
      "max_pages": 20
    }
  ],
  "returns": "orders",
  "tests": [
    {
      "args": {
        "status": "paid"
      },
      "expect": {
        "min_rows": 4,
        "max_rows": 4,
        "all_rows_match": {
          "Status": "^paid$"
        }
      }
    },
    {
      "args": {
        "query": "li"
      },
      "expect": {
        "min_rows": 3,
        "all_rows_match": {
          "Customer": "(?i)li"
        }
      }
    }
  ]
}
