{
  "id": "oceanengine",
  "name": "巨量引擎 · 巨量广告",
  "version": "0.1.0",
  "description": "Skeleton for Ocean Engine (巨量广告/巨量千川) back-offices. Capabilities are forged from the user's recordings in their own logged-in profile; this pack ships the login detection and the money/approval risk map so they are enforced from day one. Entry URLs are starting points — verify them in your account.",
  "base_url": "https://ad.oceanengine.com",
  "login": {
    "check_url": "{base_url}/",
    "logged_out_url": "(login|sso|passport)"
  },
  "modules": [
    {
      "id": "promotion",
      "name": "推广 (计划/广告/创意)"
    },
    {
      "id": "report",
      "name": "数据报表"
    },
    {
      "id": "assets",
      "name": "资产 (素材/落地页/定向包)"
    },
    {
      "id": "finance",
      "name": "财务 (充值/流水)"
    }
  ],
  "entities": [
    {
      "id": "plan",
      "fields": [
        "计划ID",
        "计划名称",
        "状态",
        "预算",
        "出价",
        "消耗",
        "展示",
        "点击",
        "转化"
      ]
    },
    {
      "id": "creative",
      "fields": [
        "创意ID",
        "创意名称",
        "状态",
        "消耗",
        "点击率",
        "转化"
      ]
    },
    {
      "id": "fund",
      "fields": [
        "余额",
        "日消耗"
      ],
      "risks": [
        "money"
      ]
    }
  ],
  "risks": [
    {
      "id": "money",
      "level": "irreversible",
      "match_text": "充值|转账|提现|付款|支付|划拨",
      "reason": "moves money"
    },
    {
      "id": "submit_review",
      "level": "irreversible",
      "match_text": "提交审核|提交并审核|发布|一键起量",
      "reason": "submits ads for review / starts spend"
    },
    {
      "id": "spend_change",
      "level": "irreversible",
      "match_text": "修改预算|修改出价|调整出价|调整预算|批量修改",
      "reason": "changes spend"
    },
    {
      "id": "start_stop",
      "level": "irreversible",
      "match_text": "启用|暂停投放|开启投放|关闭投放|删除计划|删除广告|删除",
      "reason": "starts/stops/deletes delivery"
    },
    {
      "id": "export",
      "level": "submit",
      "match_text": "导出|下载报表",
      "reason": "creates a file with business data"
    }
  ],
  "hosts": [
    "qianchuan.jinritemai.com",
    "business.oceanengine.com"
  ]
}
